FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY bot_gemini_fast.py .
COPY prompt.txt .

EXPOSE 8080

# One worker: the bot keeps its own event loop and dedupe cache in memory.
# Threads handle the webhook requests, which now return immediately.
CMD exec gunicorn --bind "0.0.0.0:${PORT:-8080}" --workers 1 --threads 8 --timeout 60 "bot_gemini_fast:create_app()"
